{
  "name": "collie-lsp",
  "displayName": "Collie LSP",
  "description": "Language support for Lrama style BNF grammar files using collie-lsp",
  "version": "0.1.0",
  "publisher": "ydah",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ydah/collie-lsp.git",
    "directory": "vscode-extension"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:yacc"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "yacc",
        "extensions": [
          ".y"
        ],
        "aliases": [
          "Yacc",
          "yacc"
        ]
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Collie LSP",
      "properties": {
        "collie-lsp.serverPath": {
          "type": "string",
          "default": "collie-lsp",
          "description": "Path to collie-lsp executable"
        },
        "collie-lsp.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "verbose",
          "description": "Traces the communication between VS Code and the language server"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-dependencies",
    "check": "npm run compile && npm run package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.125.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^7.0.2"
  }
}
